{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki-kit/schema/distill/effect-contract.schema.json",
  "title": "effect contract — attestation（宣言は guard/test/evidence を決める監査契約。未発見の未宣言 effect を runtime で deny できるとは主張しない）",
  "type": "object",
  "required": ["contract_version", "skill_slug", "effects", "attestation"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "0.1"},
    "skill_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "attestation": {
      "type": "object",
      "required": ["declared_by", "declared_at", "guarantee_ceiling"],
      "additionalProperties": false,
      "properties": {
        "declared_by": {"type": "string", "minLength": 1},
        "declared_at": {"type": "string", "minLength": 1},
        "guarantee_ceiling": {"const": "review+probe+sandbox: undeclared effects found there fail validation; no runtime deny claimed"}
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/effect"}
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"lock": {"enum": ["pipeline-wide", "per-target", "none"]}, "stale_recovery": {"enum": ["manual-only", "owner-bound-resolve"]}}
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"}}
  },
  "$defs": {
    "portable_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!~)[^\\\\]*$", "description": "相対 path・/ 区切り。ドライブ文字・先頭 /・~・バックスラッシュを禁止"},
    "effect": {
      "type": "object",
      "required": ["id", "resource", "target", "op", "reversibility", "idempotency", "human_action"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]{2,3}$"},
        "resource": {"enum": ["external-api", "external-document", "local-file", "local-db", "secret-file", "host-config", "notification", "human"]},
        "target": {"type": "string", "minLength": 1, "description": "何を（spreadsheet ID・path glob・DB名・endpoint）。secret の値は書かない（locator のみ）"},
        "op": {"enum": ["read", "create", "write", "replace", "delete", "notify", "human_action"],
               "description": "create = 存在しない path への exclusive create（既存を上書きしない）。write/replace = 既存を変える。delete = 除去"},
        "reversibility": {"enum": ["none", "backup_restore", "compensating", "recreate_from_source"]},
        "idempotency": {"enum": ["idempotent", "keyed", "non_idempotent", "unknown"]},
        "human_action": {"enum": ["required", "none"]},
        "actor": {"enum": ["skill", "human", "host"], "description": "誰が実行するか（delete の主体など）"},
        "trigger": {"type": "string", "description": "いつ（例: 次回 run の prepare 時／completed 後 N 日）"},
        "precondition": {"type": "string", "minLength": 1},
        "credential_locator": {"type": "string", "minLength": 1, "description": "file 名や env 名。値は書かない"},
        "network": {
          "type": "object", "additionalProperties": false, "required": ["endpoint", "direction"],
          "properties": {"endpoint": {"type": "string", "minLength": 1}, "direction": {"enum": ["read", "write", "both"]}}
        },
        "local_io": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sensitivity", "retention", "redaction"],
          "properties": {
            "kind": {"enum": ["input", "output", "both"]},
            "sensitivity": {"enum": ["low", "medium", "high"]},
            "retention": {"type": "string", "minLength": 1, "description": "保存期間と削除主体（削除は独立 effect として宣言）"},
            "redaction": {"type": "string", "minLength": 1, "description": "evidence に残してよい field / 残さない field（ID 等）"}
          }
        },
        "backup": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "taken_before_write", "scope"],
          "properties": {"method": {"type": "string", "minLength": 1}, "taken_before_write": {"const": true}, "scope": {"type": "string", "minLength": 1}}
        },
        "irreversible_ack": {"const": true, "description": "delete で backup を取らない場合の明示承認（reversibility=none とセット）"},
        "postcondition": {"type": "string", "minLength": 1, "description": "mutation set 以上を比較する条件（values・書式・順序…）"},
        "freshness": {"type": "string", "minLength": 1, "description": "read: 取得物の新しさの条件（mtime・period）"},
        "completeness": {"type": "string", "minLength": 1, "description": "read: 取得物の完全性の条件（件数・schema）"}
      },
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["write", "replace"]}}}, "then": {"required": ["backup", "postcondition"]}},
        {"if": {"properties": {"op": {"const": "create"}}},
         "then": {"required": ["postcondition"], "properties": {"idempotency": {"enum": ["keyed", "idempotent"]}}, "not": {"required": ["backup"]}}},
        {"if": {"properties": {"op": {"const": "delete"}}},
         "then": {"required": ["actor", "trigger", "precondition", "postcondition"],
                  "anyOf": [{"required": ["backup"]}, {"required": ["irreversible_ack"], "properties": {"reversibility": {"const": "none"}}}]}},
        {"if": {"properties": {"op": {"const": "read"}}}, "then": {"required": ["freshness", "completeness"]}},
        {"if": {"properties": {"resource": {"enum": ["external-api", "external-document"]}}}, "then": {"required": ["network", "credential_locator"]}},
        {"if": {"properties": {"resource": {"enum": ["local-file", "secret-file"]}}}, "then": {"required": ["local_io"]}},
        {"$comment": "path/locator として使う target は portable_path（絶対 path・~・バックスラッシュ禁止）。外部 resource/notification/human の target は自由文字列",
         "if": {"properties": {"resource": {"enum": ["local-file", "local-db", "secret-file", "host-config"]}}},
         "then": {"properties": {"target": {"$ref": "#/$defs/portable_path"}}}},
        {"if": {"properties": {"op": {"const": "human_action"}}}, "then": {"properties": {"human_action": {"const": "required"}, "resource": {"const": "human"}}}},
        {"if": {"properties": {"op": {"const": "notify"}}}, "then": {"properties": {"resource": {"const": "notification"}, "idempotency": {"enum": ["keyed", "idempotent"]}}}}
      ]
    }
  }
}
