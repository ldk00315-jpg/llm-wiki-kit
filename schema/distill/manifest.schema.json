{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki-kit/schema/distill/manifest.schema.json",
  "title": "distill release manifest（1 version 1 file・append-only）。型と単一版内の invariant を検査する。add-only・継承禁止 field・許可遷移・推移的 hash・candidate≡deployed・event 集合の整合は validator/guard が検査する",
  "type": "object",
  "required": ["skill", "version", "state", "created", "supersedes", "supersede_reason", "runtime_refs", "common_runtime_sha256", "candidate_bundles", "deployed_bundles", "decision", "validation_evidence", "wiki_refs", "effect_contract", "observation"],
  "additionalProperties": false,
  "properties": {
    "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["proposed", "validated", "deployed", "deprecated", "rejected"]},
    "created": {"$ref": "#/$defs/utc"},
    "supersedes": {"type": ["integer", "null"]},
    "supersede_reason": {"type": "string", "minLength": 1, "description": "版固有。前版から継承しない"},
    "note": {"type": "string"},
    "runtime_refs": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "common_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_bundles": {
      "type": "object", "required": ["logical_paths"],
      "properties": {"logical_paths": {"type": "array", "items": {"$ref": "#/$defs/portable_path"}}},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "deployed_bundles": {
      "type": ["object", "null"],
      "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["files", "deployment_id", "deployed_at"], "additionalProperties": false,
        "properties": {
          "deployment_id": {"type": "string", "minLength": 1},
          "deployed_at": {"$ref": "#/$defs/utc"},
          "files": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["logical_path", "deployed_path", "sha256"], "additionalProperties": false,
            "properties": {"logical_path": {"$ref": "#/$defs/portable_path"}, "deployed_path": {"$ref": "#/$defs/portable_path"}, "sha256": {"$ref": "#/$defs/sha256"}}
          }}
        }
      }
    },
    "decision": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status": {"enum": [null, "approved", "rejected"]},
        "by": {"type": "string", "minLength": 1},
        "at": {"$ref": "#/$defs/utc"},
        "reason": {"type": "string", "minLength": 1},
        "given_via": {"type": "string", "minLength": 1},
        "bound_to": {
          "type": "object", "additionalProperties": false,
          "required": ["manifest_version", "candidate_bundle_sha256", "common_runtime_sha256", "effect_contract_sha256", "wiki_ref_sha256s"],
          "properties": {
            "manifest_version": {"type": "integer", "minimum": 1},
            "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"},
            "common_runtime_sha256": {"$ref": "#/$defs/sha256"},
            "effect_contract_sha256": {"$ref": "#/$defs/sha256"},
            "wiki_ref_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
          }
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["approved", "rejected"]}}, "required": ["status"]},
         "then": {"required": ["by", "at", "reason", "given_via", "bound_to"]}},
        {"if": {"properties": {"status": {"const": null}}},
         "then": {"not": {"anyOf": [{"required": ["by"]}, {"required": ["bound_to"]}]}}}
      ]
    },
    "validation_evidence": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "negative_evidence": {"type": "array", "items": {"$ref": "#/$defs/file_ref_role"}},
    "invalidated_evidence": {"type": "array", "items": {"$ref": "#/$defs/file_ref_reason"}},
    "observation_findings": {"type": "array", "items": {
      "type": "object", "required": ["id", "evidence", "status"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "run_id": {"type": "string"}, "evidence": {"type": "string"}, "status": {"type": "string"}}
    }},
    "wiki_refs": {"type": "array", "items": {
      "type": "object", "required": ["base_id", "path", "sha256", "review"], "additionalProperties": false,
      "properties": {
        "base_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "description": "portable な base 識別子（例 vault）。実 path への解決は host 設定側。絶対 path は書かない"},
        "path": {"$ref": "#/$defs/portable_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "distill_id": {"type": "string", "pattern": "^d-[0-9a-f]{8}$"},
        "review": {"type": "string", "pattern": "^(approved|pending):.+"}
      }
    }},
    "effect_contract": {"$ref": "#/$defs/file_ref"},
    "observation": {
      "type": "object",
      "required": ["min_observation_period_days", "min_eligible_opportunities", "min_completed_opportunities", "verdict"],
      "additionalProperties": false,
      "properties": {
        "min_observation_period_days": {"type": "integer", "minimum": 1},
        "min_eligible_opportunities": {"type": "integer", "minimum": 1},
        "min_completed_opportunities": {"type": "integer", "minimum": 1},
        "verdict": {"enum": ["pending", "inconclusive", "pass", "fail"]},
        "verdict_by": {"type": "string", "minLength": 1},
        "verdict_at": {"$ref": "#/$defs/utc"},
        "verdict_reason": {"type": "string", "minLength": 1},
        "window": {"type": "object", "required": ["start", "end"], "additionalProperties": false,
                   "properties": {"start": {"$ref": "#/$defs/utc"}, "end": {"$ref": "#/$defs/utc"}}},
        "eligible_count": {"type": "integer", "minimum": 0},
        "completed_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0},
        "unterminated_count": {"type": "integer", "minimum": 0},
        "terminal_conflicts": {"type": "integer", "minimum": 0},
        "event_set": {"type": "object", "required": ["head_event_id", "events_sha256", "evidence"], "additionalProperties": false,
                      "properties": {"head_event_id": {"type": "string"}, "events_sha256": {"$ref": "#/$defs/sha256"}, "evidence": {"$ref": "#/$defs/file_ref"}}}
      },
      "allOf": [
        {"$comment": "pass|fail を記録する版は監査 field を必須にする",
         "if": {"properties": {"verdict": {"enum": ["pass", "fail"]}}},
         "then": {"required": ["verdict_by", "verdict_at", "verdict_reason", "window", "eligible_count", "completed_count", "blocked_count", "unterminated_count", "terminal_conflicts", "event_set"],
                  "properties": {"terminal_conflicts": {"const": 0}}}},
        {"$comment": "pass は eligible>=1 かつ completed>=1 を最低条件にする（閾値との比較は validator）",
         "if": {"properties": {"verdict": {"const": "pass"}}},
         "then": {"properties": {"eligible_count": {"minimum": 1}, "completed_count": {"minimum": 1}, "unterminated_count": {"const": 0}}}}
      ]
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"}, "description": "タスク固有 field は extensions.<plugin-id> へ"}
  },
  "allOf": [
    {"$comment": "deployed|deprecated は approved decision と deployed_bundles を要求",
     "if": {"properties": {"state": {"enum": ["deployed", "deprecated"]}}},
     "then": {"properties": {"decision": {"properties": {"status": {"const": "approved"}}, "required": ["status", "bound_to"]},
                             "deployed_bundles": {"type": "object"}}}},
    {"$comment": "rejected は reject decision（actor/reason/binding）を要求",
     "if": {"properties": {"state": {"const": "rejected"}}},
     "then": {"properties": {"decision": {"properties": {"status": {"const": "rejected"}}, "required": ["status", "by", "reason", "bound_to"]}}}},
    {"$comment": "proposed|validated では deployed_bundles は null",
     "if": {"properties": {"state": {"enum": ["proposed", "validated"]}}},
     "then": {"properties": {"deployed_bundles": {"type": "null"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "portable_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!~)(?!\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f]+)*$", "description": "相対 path・/ 区切り。ドライブ文字・先頭 /・~・バックスラッシュを禁止（配備先は host adapter の canonical 名で表す）"},
    "file_ref": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
                 "properties": {"path": {"$ref": "#/$defs/portable_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "file_ref_role": {"type": "object", "required": ["path", "sha256", "role"], "additionalProperties": false,
                      "properties": {"path": {"$ref": "#/$defs/portable_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"type": "string"}}},
    "file_ref_reason": {"type": "object", "required": ["path", "sha256", "reason"], "additionalProperties": false,
                        "properties": {"path": {"$ref": "#/$defs/portable_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "reason": {"type": "string"}}}
  }
}
