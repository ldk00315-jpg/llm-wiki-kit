{
  "description": "Inject the LLM Wiki index and persist pre-compaction boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"/absolute/path/to/llm-wiki-kit/adapters/codex/session_start.py\"",
            "commandWindows": "python \"C:\\absolute\\path\\to\\llm-wiki-kit\\adapters\\codex\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Loading LLM Wiki index",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"/absolute/path/to/llm-wiki-kit/adapters/codex/pre_compact.py\"",
            "commandWindows": "python \"C:\\absolute\\path\\to\\llm-wiki-kit\\adapters\\codex\\pre_compact.py\"",
            "timeout": 10,
            "statusMessage": "Saving LLM Wiki compaction boundary"
          }
        ]
      }
    ]
  }
}
